{
  "name": "ai-tool-universe-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "tsc -b && vite build",
    "lint": "eslint src vite.config.ts eslint.config.js",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4177",
    "smoke:visual": "npm run smoke:visual:release",
    "smoke:visual:fast": "playwright test --project=desktop-chromium",
    "smoke:visual:release": "playwright test",
    "size:check": "node scripts/check-bundle-size.mjs",
    "test": "vitest run src"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/vite": "^4.2.4",
    "lucide-react": "^1.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
