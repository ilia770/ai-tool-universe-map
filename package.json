{
  "name": "ai-tool-universe-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "tsc -b && vite build",
    "lint": "eslint src vite.config.ts eslint.config.js",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4177",
    "smoke:visual": "npm run smoke:visual:release",
    "smoke:visual:fast": "playwright test --project=desktop-chromium",
    "smoke:visual:release": "playwright test",
    "ios:build": "bash scripts/ios-verify.sh --build-only",
    "ios:test-build": "bash scripts/ios-verify.sh --test-build-only",
    "ios:test": "bash scripts/ios-verify.sh --run-tests",
    "ios:ui-test": "bash scripts/ios-verify.sh --run-ui-tests",
    "ios:verify": "bash scripts/ios-verify.sh",
    "release:check": "bash scripts/release-check.sh",
    "size:check": "node scripts/check-bundle-size.mjs",
    "test": "vitest run src"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
